# PostgreSQL connection string. Add the real credentials only to .env.
DATABASE_URL=""

# Local NextAuth settings. Update NEXTAUTH_URL for each deployed environment.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI assistant (optional). Without a key the assistant uses a rule-based fallback.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Payments. Paystack: https://dashboard.paystack.com/#/settings/developer
# Set the webhook URL there to <NEXTAUTH_URL>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""

# M-Pesa (Safaricom Daraja STK Push): https://developer.safaricom.co.ke
# M-Pesa is offered only when the store currency (Admin > Settings) is KES.
MPESA_ENV="sandbox"            # "sandbox" or "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""             # Paybill/Till shortcode (sandbox: 174379)
MPESA_PASSKEY=""               # Lipa na M-Pesa Online passkey
MPESA_CALLBACK_SECRET=""       # Any long random string; becomes part of the callback URL
# MPESA_TRANSACTION_TYPE="CustomerBuyGoodsOnline"  # only for Till numbers (default is Paybill)
# MPESA_PARTY_B=""                                 # the Till number, for Till payments

# Expires unpaid orders (see README). Any long random string.
CRON_SECRET=""

# Order confirmation emails via Resend (optional; no email is sent without both).
RESEND_API_KEY=""
EMAIL_FROM="ShopWave <orders@your-domain.com>"
